<Window x:Class="TechArrow.GameUpdater.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Title="TechArrow Game Updater — v0.1.0" Width="1180" Height="820"
        MinWidth="640" MinHeight="420" WindowStartupLocation="CenterScreen" SizeChanged="Window_SizeChanged">
    <TabControl>
        <TabItem Header="Обзор">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Обзор лаунчеров" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Все игровые клиенты — в одном месте." Style="{StaticResource Caption}" Margin="0,0,0,26"/>
                    <Border Style="{StaticResource Card}" Background="#1B3038" BorderBrush="#365762" Padding="20,16">
                        <StackPanel><TextBlock Text="Обслуживание Steam" FontWeight="SemiBold" Foreground="#ADFFED"/><TextBlock Text="Запустите загрузки в Steam и включите мониторинг. По завершении можно автоматически закрыть клиент." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Grid Margin="0,4,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Игровые клиенты" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="8 клиентов · мониторинг и автозакрытие" Style="{StaticResource Caption}" FontSize="13" Margin="0,5,12,0"/></StackPanel><Button Grid.Column="1" Content="Обновить всё" Command="{Binding UpdateAllCommand}" VerticalAlignment="Center" ToolTip="Steam: подготовка очереди и мониторинг. Остальные клиенты: автообновления, мониторинг процессов и закрытие после простоя."/></Grid>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="{Binding AllUpdateStatus}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,14"/><TextBlock Text="Steam · библиотеки и обновления" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SteamSummary}" Margin="0,10,0,8"/>
                        <TextBlock Text="{Binding SteamLibraries}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding SteamWarnings}" Foreground="#F4D396" Margin="0,8,0,12"/>
                        <WrapPanel><Button Content="Найти Steam и игры" Command="{Binding ScanSteamCommand}" Margin="0,0,12,8"/><Button Content="Открыть Steam" Command="{Binding StartSteamCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
                        <TextBlock Text="После изменения пути нажмите «Найти Steam и игры». Авторизация и обновления выполняются в клиенте Steam." Style="{StaticResource Caption}" FontSize="12"/>
                        <Border Height="1" Background="#2B3749" Margin="0,18,0,16"/>
                        <TextBlock Text="{Binding MonitorStatus}" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MonitorDetail}" Style="{StaticResource Caption}" Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{Binding UpdateText}" Margin="0,0,0,14"/>
                        <CheckBox Content="Закрыть Steam после завершения наблюдавшихся обновлений" IsChecked="{Binding AutoCloseSteam}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
                        <WrapPanel><Button Content="Запустить обновления Steam" Command="{Binding UpdateSteamCommand}" Margin="0,0,12,8"/><Button Content="Начать мониторинг" Command="{Binding MonitorSteamCommand}" Margin="0,0,12,8"/><Button Content="Остановить" Command="{Binding StopMonitorCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
                        <TextBlock Text="«Запустить обновления Steam» подготавливает отложенные обновления во всех библиотеках и включает мониторинг. Для подготовки Steam перезапускается, если нет активных игр или загрузок. Мониторинг проверяет файлы каждые 3 секунды. Процент относится к скачиванию; установка проверяется отдельно. Простои, паузы и неизвестные данные не подтверждают завершение." Style="{StaticResource Caption}" FontSize="12"/>

                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Автозакрытие остальных лаунчеров" FontSize="20" FontWeight="SemiBold"/>
                        <CheckBox Content="Закрывать Epic, Lesta, Battle.net, EA, Riot, VK Play и Wargaming после простоя" IsChecked="{Binding Settings.AutoCloseOtherLaunchers}" Foreground="{StaticResource TextBrush}" Margin="0,14,0,12"/>
                        <TextBlock Text="Работает при «Обновить всё» и по расписанию. По умолчанию: 5 минут без существенной активности + пауза перед закрытием. Новая активность сбрасывает отсчёт. Если обнаружена игра, ввод пользователя или другое активное окно, закрытие откладывается. У этих клиентов простой не подтверждает завершение всей очереди: при паузе или потере сети клиент тоже может перестать передавать данные." Style="{StaticResource Caption}" FontSize="12"/>
                        <TextBlock Text="Для измерения сети и диска Windows попросит подтвердить запуск отдельного сборщика. При отказе или потере данных закрытие блокируется. Выход запрашивается через трей или закрытие окна. Если клиент остаётся в фоне, карточка и журнал покажут это. Игровые процессы и фоновые службы принудительно не завершаются. Чтобы сохранить выбранный режим для следующих запусков, нажмите «Сохранить настройки»." Style="{StaticResource Caption}" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                    <ItemsControl ItemsSource="{Binding Launchers}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="22,20">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Width="42" Height="42" Background="#2A3D56" CornerRadius="10" VerticalAlignment="Top"><Grid><TextBlock Text="↗" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AFCDF7"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding Authorization}" Style="{StaticResource Caption}" FontSize="13" Margin="0,5,8,0"/></StackPanel>
                                        <Border Grid.Column="1" Grid.Row="1" Background="#383124" CornerRadius="6" Padding="10,5" Margin="0,10,0,0" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" Foreground="#F4D396" FontSize="12"/></Border>
                                    </Grid>
                                    <Border Height="1" Background="#2B3749" Margin="0,18,0,14"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="14"/>
                                    <TextBlock Text="{Binding ActivityText}" Foreground="#ADFFED" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding ActivityText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <ItemsControl ItemsSource="{Binding Games}" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <StackPanel Margin="0,8,0,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding InstallPath}" Style="{StaticResource Caption}" FontSize="12"/></StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Card}" Padding="20,16"><StackPanel><TextBlock Text="Следующее обслуживание" FontWeight="SemiBold"/><TextBlock Text="{Binding NextMaintenance}" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBlock Text="{Binding ScheduleStatus}" Foreground="#F4D396" Margin="0,8,0,0"/></StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Настройки">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel DataContext="{Binding Settings}" Margin="0,0,8,0">
                    <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Выберите файлы лаунчеров и параметры обслуживания." Style="{StaticResource Caption}" Margin="0,0,0,26"/>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Пути лаунчеров" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="Нажмите «Выбрать .exe» и выберите файл клиента. Путь сохранится автоматически. Для Steam сразу найдутся библиотеки и игры." Style="{StaticResource Caption}" Margin="0,8,0,22"/>
                        <Label Target="{Binding ElementName=SteamPathInput}" Foreground="#F1F5FC" Padding="0" Content="Steam"/>
                        <Grid Margin="0,7,0,18" IsEnabled="{Binding DataContext.CanChangeLauncherPaths, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SteamPathInput" Text="{Binding SteamPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Путь Steam" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="Выбрать .exe" Tag="Steam" Click="ChooseExecutable_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" IsEnabled="{Binding CanSelectFiles}" AutomationProperties.Name="Выбрать файл Steam"/>
                        </Grid>
                        <Label Target="{Binding ElementName=EpicPathInput}" Foreground="#F1F5FC" Padding="0" Content="Epic Games Launcher"/>
                        <Grid Margin="0,7,0,18" IsEnabled="{Binding DataContext.CanChangeLauncherPaths, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="EpicPathInput" Text="{Binding EpicPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Путь Epic Games Launcher" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="Выбрать .exe" Tag="Epic" Click="ChooseExecutable_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" IsEnabled="{Binding CanSelectFiles}" AutomationProperties.Name="Выбрать файл Epic"/>
                        </Grid>
                        <Label Target="{Binding ElementName=LestaPathInput}" Foreground="#F1F5FC" Padding="0" Content="Lesta Game Center"/>
                        <Grid Margin="0,7,0,18" IsEnabled="{Binding DataContext.CanChangeLauncherPaths, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="LestaPathInput" Text="{Binding LestaPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Путь Lesta Game Center" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="Выбрать .exe" Tag="Lesta" Click="ChooseExecutable_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" IsEnabled="{Binding CanSelectFiles}" AutomationProperties.Name="Выбрать файл Lesta"/>
                        </Grid>
                        <Label Target="{Binding ElementName=BattleNetPathInput}" Foreground="#F1F5FC" Padding="0" Content="Battle.net" Margin="0,14,0,0"/>
                        <Grid Margin="0,7,0,18" IsEnabled="{Binding DataContext.CanChangeLauncherPaths, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="BattleNetPathInput" Text="{Binding BattleNetPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Путь Battle.net" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="Выбрать .exe" Tag="BattleNet" Click="ChooseExecutable_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" IsEnabled="{Binding CanSelectFiles}" AutomationProperties.Name="Выбрать файл BattleNet"/>
                        </Grid>
                        <Label Target="{Binding ElementName=EaPathInput}" Foreground="#F1F5FC" Padding="0" Content="EA app" Margin="0,14,0,0"/>
                        <Grid Margin="0,7,0,18" IsEnabled="{Binding DataContext.CanChangeLauncherPaths, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="EaPathInput" Text="{Binding EaPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Путь EA app" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="Выбрать .exe" Tag="Ea" Click="ChooseExecutable_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" IsEnabled="{Binding CanSelectFiles}" AutomationProperties.Name="Выбрать файл Ea"/>
                        </Grid>
                        <Label Target="{Binding ElementName=RiotPathInput}" Foreground="#F1F5FC" Padding="0" Content="Riot Client" Margin="0,14,0,0"/>
                        <Grid Margin="0,7,0,18" IsEnabled="{Binding DataContext.CanChangeLauncherPaths, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="RiotPathInput" Text="{Binding RiotPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Путь Riot Client" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="Выбрать .exe" Tag="Riot" Click="ChooseExecutable_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" IsEnabled="{Binding CanSelectFiles}" AutomationProperties.Name="Выбрать файл Riot"/>
                        </Grid>
                        <Label Target="{Binding ElementName=VkPlayPathInput}" Foreground="#F1F5FC" Padding="0" Content="VK Play" Margin="0,14,0,0"/>
                        <Grid Margin="0,7,0,18" IsEnabled="{Binding DataContext.CanChangeLauncherPaths, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="VkPlayPathInput" Text="{Binding VkPlayPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Путь VK Play" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="Выбрать .exe" Tag="VkPlay" Click="ChooseExecutable_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" IsEnabled="{Binding CanSelectFiles}" AutomationProperties.Name="Выбрать файл VkPlay"/>
                        </Grid>
                        <Label Target="{Binding ElementName=WargamingPathInput}" Foreground="#F1F5FC" Padding="0" Content="Wargaming Game Center" Margin="0,14,0,0"/>
                        <Grid Margin="0,7,0,18" IsEnabled="{Binding DataContext.CanChangeLauncherPaths, RelativeSource={RelativeSource AncestorType=Window}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="WargamingPathInput" Text="{Binding WargamingPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Путь Wargaming Game Center" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" Content="Выбрать .exe" Tag="Wargaming" Click="ChooseExecutable_Click" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" IsEnabled="{Binding CanSelectFiles}" AutomationProperties.Name="Выбрать файл Wargaming"/>
                        </Grid>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Обновления самой программы" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="Все компьютеры должны использовать один источник новых версий." Style="{StaticResource Caption}" Margin="0,8,0,16"/>
                        <TextBlock Text="HTTPS-адрес, репозиторий GitHub или общая папка"/><TextBox Text="{Binding AppUpdateSource, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Источник обновлений TechArrow"/>
                        <CheckBox Content="Автоматически проверять и скачивать новые версии" IsChecked="{Binding AutomaticAppUpdates}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>
                        <CheckBox Content="Автоматически устанавливать в трее после окончания обслуживания" IsChecked="{Binding AutoInstallAppUpdates}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>
                        <TextBlock Text="Пустое поле использует адрес, заданный в установщике. Настройки компьютера сохраняются. Применение обновления требует перезапуска программы." Style="{StaticResource Caption}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Работа в фоне" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="Крестик сворачивает приложение в трей. Расписание и мониторинг продолжают работать. Чтобы завершить программу, нажмите «Выйти» в меню значка возле часов." Style="{StaticResource Caption}" Margin="0,8,0,18"/>
                        <CheckBox Content="Запускать с Windows в трее" IsChecked="{Binding AutoStartWithWindows}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="Применяется кнопкой «Сохранить настройки». При следующем входе в Windows приложение запустится без открытия окна." Style="{StaticResource Caption}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Расписание обслуживания клиентов" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="Время Кызылорды (UTC+5). Расписание работает, пока программа запущена, в том числе в трее. Пропущенные запуски не выполняются задним числом." Style="{StaticResource Caption}" Margin="0,8,0,18"/>
                        <CheckBox Content="Включить расписание" IsChecked="{Binding ScheduleEnabled}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
                        <WrapPanel Margin="0,0,0,16">
                            <CheckBox Content="Пн" IsChecked="{Binding Monday}" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                            <CheckBox Content="Вт" IsChecked="{Binding Tuesday}" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                            <CheckBox Content="Ср" IsChecked="{Binding Wednesday}" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                            <CheckBox Content="Чт" IsChecked="{Binding Thursday}" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                            <CheckBox Content="Пт" IsChecked="{Binding Friday}" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                            <CheckBox Content="Сб" IsChecked="{Binding Saturday}" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                            <CheckBox Content="Вс" IsChecked="{Binding Sunday}" Foreground="{StaticResource TextBrush}" Margin="0,0,18,8"/>
                        </WrapPanel>
                        <TextBlock Text="Время запуска · ЧЧ:ММ"/><TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" MaxLength="5" AutomationProperties.Name="Время запуска расписания"/>
                        <CheckBox Content="Закрывать Steam после подтверждённого завершения обновлений" IsChecked="{Binding ScheduleAutoClose}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
                        <TextBlock Text="Нажмите «Сохранить настройки», чтобы применить расписание. Оно запускает выбранные клиенты для их автообновлений, подготавливает отложенные обновления Steam и включает его мониторинг. Режим подготовленных игр меняется на немедленное обновление; оригинальные манифесты сохраняются локально." Style="{StaticResource Caption}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Мониторинг активности" FontSize="21" FontWeight="SemiBold"/>
                        <Button Content="Включить измерения сети и диска" Click="EnableMeasurements_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,8" IsEnabled="{Binding DataContext.CanChangeLauncherPaths, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <TextBlock Text="{Binding DataContext.CollectorStatus, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="Для обслуживания по расписанию включите измерения заранее и оставьте программу в трее. После обслуживания сборщик завершится. Ночью запрос UAC не показывается: если сборщик не включён, клиенты останутся открытыми." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                        <TextBlock Text="Время простоя и пауза фиксируются при запуске мониторинга. Изменения применяются к следующей сессии." Style="{StaticResource Caption}" Margin="0,8,0,22"/>
                        <UniformGrid><UniformGrid.Style><Style TargetType="UniformGrid"><Setter Property="Columns" Value="2"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact"><Setter Property="Columns" Value="1"/></DataTrigger></Style.Triggers></Style></UniformGrid.Style>
                            <StackPanel Margin="0,0,20,0"><TextBlock Text="Порог сети · КБ/с"/><TextBox Text="{Binding Network, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Порог сети в КБ/с"/></StackPanel>
                            <StackPanel><TextBlock Text="Порог диска · МБ/с"/><TextBox Text="{Binding Disk, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Порог записи на диск в МБ/с"/></StackPanel>
                            <StackPanel Margin="0,0,20,0"><TextBlock Text="Время простоя · секунды"/><TextBox Text="{Binding Idle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Время простоя в секундах"/></StackPanel>
                            <StackPanel><TextBlock Text="Пауза перед закрытием · секунды"/><TextBox Text="{Binding Grace, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Grace Period в секундах"/></StackPanel>
                            <StackPanel Margin="0,0,20,0"><TextBlock Text="Простой остальных клиентов · секунды (60–86400)"/><TextBox Text="{Binding OtherIdle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Простой остальных лаунчеров в секундах"/></StackPanel>
                        </UniformGrid>
                        <CheckBox Content="Автоматически закрывать остальные лаунчеры после простоя" IsChecked="{Binding AutoCloseOtherLaunchers}" Foreground="{StaticResource TextBrush}" Margin="0,12,0,12"/>
                        <TextBlock Text="Скорости измеряются отдельно для процессов клиента и его помощников. Закрытие разрешается, когда сеть и диск ниже порогов в течение заданного времени и паузы. CPU и другие операции ввода-вывода также могут отложить закрытие. Windows запросит права администратора для отдельного сборщика; при отказе клиент останется открытым. Изменения порогов нужно сохранить." Style="{StaticResource Caption}"/>
                    </StackPanel></Border>
                    <WrapPanel Margin="0,6,0,12"><Button Content="Сохранить настройки" Command="{Binding SaveCommand}" Margin="0,0,12,8"/><Button Content="Перечитать файл" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
                    <TextBlock Text="{Binding Message}" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="Файл настроек" FontWeight="SemiBold"/><TextBlock Text="{Binding FilePath}" Style="{StaticResource Caption}" FontSize="13" Margin="0,5,0,16"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="История запусков">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="История запусков" Style="{StaticResource PageTitle}"/><TextBlock Text="Последние 50 запусков · время UTC+5 · полный список до 500 запусков сохраняется локально. Завершение загрузок остальных клиентов не подтверждается." Style="{StaticResource Caption}" Margin="0,8,0,24"/></StackPanel>
                <TextBox Grid.Row="1" Text="{Binding HistoryText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="18" AutomationProperties.Name="История запусков"/>
            </Grid>
        </TabItem>
        <TabItem Header="Кабинет клубов">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel DataContext="{Binding Club}" Margin="0,0,8,0">
                <TextBlock Text="Кабинет клубов" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Подключите этот компьютер к своему серверу. В кабинете видны состояние клиентов, версия программы и последние запуски." Style="{StaticResource Caption}" Margin="0,10,0,24"/>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="Адрес сервера" FontWeight="SemiBold"/><TextBox Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Адрес сервера кабинета" Margin="0,8,0,16"/>
                    <TextBlock Text="Ключ этого компьютера" FontWeight="SemiBold"/><PasswordBox x:Name="ClubDeviceKey" Background="#101B2A" Foreground="#F1F5FC" BorderBrush="#3B5069" Padding="12" FontSize="16" Margin="0,8,0,16" AutomationProperties.Name="Ключ компьютера"/>
                    <WrapPanel><Button Content="Подключить" Click="ConnectClub_Click" Margin="0,0,12,8"/><Button Content="Отправить состояние" Command="{Binding SendCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8"/><Button Content="Отключить" Command="{Binding DisconnectCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel></Border>
                <TextBlock Text="Создайте отдельный ключ в веб-кабинете для каждого ПК. Для связи через интернет нужен HTTPS. Передаются только статусы клиентов и краткая история запусков; пути игр, подробные логи и пароли не отправляются. Ключ хранится локально в зашифрованном виде." Style="{StaticResource Caption}"/>
            </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Журнал событий">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Журнал событий" Style="{StaticResource PageTitle}"/><TextBlock Text="Действия приложения и сообщения об ошибках." Style="{StaticResource Caption}" Margin="0,0,0,24"/></StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding LogError}" Foreground="#FFB7AA" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
                <TextBox Grid.Row="2" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Padding="18" Margin="0" AutomationProperties.Name="Журнал событий"/>
                <TextBlock Grid.Row="3" Text="Обновляется каждую секунду · Последние 1000 событий · Полный журнал сохраняется в файл" Style="{StaticResource Caption}" FontSize="12" Margin="0,14,0,0"/>
            </Grid>
        </TabItem>
        <TabItem Header="О приложении">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
                <TextBlock Text="TechArrow Game Updater" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Обновления программы" Style="{StaticResource Caption}" Margin="0,0,0,26"/>
                <Border Style="{StaticResource Card}" DataContext="{Binding Updates}"><StackPanel>
                    <TextBlock Text="Обновления TechArrow" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CurrentVersion, StringFormat=Текущая версия: {0}}" Margin="0,10,0,8"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,0,0,16"/>
                    <WrapPanel><Button Content="Проверить обновления" Command="{Binding CheckCommand}" Margin="0,0,12,8"/><Button Content="Установить и перезапустить" Command="{Binding InstallCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel>
                    <TextBlock Text="Что изменилось" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Updates.CurrentVersion, StringFormat=Версия {0}}" FontSize="17" FontWeight="SemiBold" Foreground="#ADFFED" Margin="0,18,0,8"/>
                    <TextBlock Text="• Если измерения недоступны, Steam остаётся открытым, а завершённое обслуживание корректно заканчивается." Style="{StaticResource Caption}"/><TextBlock Text="Версия 0.2.8" FontSize="17" FontWeight="SemiBold" Foreground="#ADFFED" Margin="0,22,0,8"/><TextBlock Text="• Добавлены отдельные измерения сети и диска процессов лаунчеров.&#10;• Автозакрытие учитывает оба порога, время простоя и паузу.&#10;• При отсутствии данных или отказе в доступе Windows клиент остаётся открытым.&#10;• Steam дополнительно подтверждает завершение по манифестам." Style="{StaticResource Caption}"/>
                    <TextBlock Text="Версия 0.2.7" FontSize="17" FontWeight="SemiBold" Foreground="#ADFFED" Margin="0,22,0,8"/><TextBlock Text="• Распознавание выбранного .exe, проверка пути и иконки лаунчеров с локальным кэшем." Style="{StaticResource Caption}"/>
                    <TextBlock Text="Версия 0.2.6" FontSize="17" FontWeight="SemiBold" Foreground="#ADFFED" Margin="0,22,0,8"/>
                    <TextBlock Text="• Адаптивное меню, перенос текста и параметров, тёмная прокрутка и поддержка масштаба Windows." Style="{StaticResource Caption}"/>
                    <TextBlock Text="Версия 0.2.5" FontSize="17" FontWeight="SemiBold" Foreground="#ADFFED" Margin="0,22,0,8"/>
                    <TextBlock Text="• Добавлен список изменений по версиям вместо устаревших этапов разработки." Style="{StaticResource Caption}"/>
                    <TextBlock Text="Версия 0.2.4" FontSize="17" FontWeight="SemiBold" Foreground="#ADFFED" Margin="0,22,0,8"/>
                    <TextBlock Text="• Добавлен мониторинг Epic Games, Lesta, Battle.net, EA, Riot, VK Play и Wargaming.&#10;• Добавлено автозакрытие после устойчивого простоя при «Обновить всё» и обслуживании по расписанию.&#10;• В настройках можно отключить автозакрытие и изменить время ожидания.&#10;• Активность пользователя и обнаруженные игры откладывают закрытие. Простой не подтверждает завершение загрузок." Style="{StaticResource Caption}"/>
                    <TextBlock Text="Версия 0.2.3" FontSize="17" FontWeight="SemiBold" Foreground="#ADFFED" Margin="0,22,0,8"/>
                    <TextBlock Text="• Добавлены история запусков и уведомления об ошибках.&#10;• Добавлено подключение компьютеров к кабинету клубов." Style="{StaticResource Caption}"/>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}" Background="#1B3038" BorderBrush="#365762"><StackPanel><TextBlock Text="Безопасность аккаунтов" FontSize="19" FontWeight="SemiBold" Foreground="#ADFFED"/><TextBlock Text="Логины, пароли и коды двухфакторной авторизации не запрашиваются и не хранятся. Будущие модули будут использовать сохранённые сессии официальных клиентов." Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
            </StackPanel></ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
